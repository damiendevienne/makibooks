{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "firstName": { "type": "string", "maxLength": 80 },
    "lastName": { "type": "string", "maxLength": 80 },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "books": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::book.book",
      "mappedBy": "owner"
    },
    "zones": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::zone.zone",
      "mappedBy": "users"
    },
    "preferredLocale": {
      "type": "enumeration",
      "enum": ["en", "fr", "el"],
      "default": "en"
    },
    "theme": {
      "type": "enumeration",
      "enum": ["system", "light", "dark"],
      "default": "system"
    },
    "emailNotifications": {
      "type": "boolean",
      "default": true
    },
    "communityCharterAccepted": {
      "type": "boolean",
      "default": false
    },
    "favoriteBookIds": {
      "type": "json",
      "default": []
    },
    "conversationsAsFirstParticipant": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::conversation.conversation",
      "mappedBy": "participantOne"
    },
    "conversationsAsSecondParticipant": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::conversation.conversation",
      "mappedBy": "participantTwo"
    },
    "messages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::message.message",
      "mappedBy": "sender"
    },
    "pushSubscriptions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::push-subscription.push-subscription",
      "mappedBy": "user"
    },
    "lastActivityDigestAt": {
      "type": "datetime"
    },
    "loansAsLender": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::loan.loan",
      "mappedBy": "lender"
    },
    "loansAsBorrower": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::loan.loan",
      "mappedBy": "borrower"
    }
  }
}
